{
  "hooks": {
    "PreToolUse": [
      {
        "commands": ["git push", "git commit"],
        "type": "command",
        "command": "echo '❌ FATAL: Committing and pushing is protected. See MANUAL_TASKS.md.' && exit 1"
      }
    ],
    "PostToolUse": [
      {
        "commands": ["edit_file", "write_file"],
        "type": "command",
        "command": "npm run format"
      }
    ]
  }
}
